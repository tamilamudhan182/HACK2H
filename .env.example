# Smart Event Companion — Environment Variables
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control (it is already in .gitignore).
#
# ─── Firebase ─────────────────────────────────────────────────────────────────
# Get these from: https://console.firebase.google.com → Project Settings → General → SDK Setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Google Maps Embed API ────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Maps Embed API
VITE_GOOGLE_MAPS_EMBED_KEY=

# ─── Google Pay ───────────────────────────────────────────────────────────────
# Get from: https://pay.google.com/business/console
VITE_GOOGLE_PAY_MERCHANT_ID=

# ─── Google Analytics ─────────────────────────────────────────────────────────
# Get from: https://analytics.google.com → Admin → Data Streams → Measurement ID
VITE_GA_MEASUREMENT_ID=

# ─── App Config ───────────────────────────────────────────────────────────────
VITE_APP_ENV=development
